GOOGLE_GENERATIVE_AI_API_KEY=

# Absolute path to the memory database, e.g. file:/Users/you/projects/my-app/mastra.db
MASTRA_DB_URL=

# Zapier MCP server (lesson 2): https://mcp.zapier.com -> your server -> Connect tab
ZAPIER_MCP_URL=https://mcp.zapier.com/api/v1/connect
ZAPIER_MCP_API_KEY=

# GitHub MCP server (lesson 2): fine-grained PAT, read-only, https://github.com/settings/personal-access-tokens/new
GITHUB_PERSONAL_ACCESS_TOKEN=

# Filesystem MCP server (lesson 2): absolute path to the only folder the agent can read and write
NOTES_DIR=

# Vector store for semantic recall (lesson 2), absolute path, e.g. file:/Users/you/projects/my-app/vector.db
MASTRA_VECTOR_DB_URL=
